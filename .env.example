# LLM Configuration
RUBBER_DUCKY_LLM_PROVIDER=claude  # or 'ollama'
RUBBER_DUCKY_CLAUDE_API_KEY=your_api_key_here
RUBBER_DUCKY_CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Ollama Configuration (if using Ollama)
RUBBER_DUCKY_OLLAMA_BASE_URL=http://localhost:11434
RUBBER_DUCKY_OLLAMA_MODEL=llama3.2

# Voice Configuration
RUBBER_DUCKY_XTTS_VOICE_SAMPLE=~/dev/rubber-ducky/data/voice_samples/default.wav

# Paths (optional overrides)
RUBBER_DUCKY_DATA_DIR=~/dev/rubber-ducky/data

# WhisperX Model
RUBBER_DUCKY_WHISPER_MODEL=base  # tiny, base, small, medium, large

# VAD Thresholds
RUBBER_DUCKY_VAD_THRESHOLD=0.5
RUBBER_DUCKY_VAD_MIN_SILENCE_DURATION=0.8
